# MangaDex Application Environment Configuration Template
# Copy this file to .env and fill in your credentials if needed.

# --- Global Service URLs & Client Identity ---
MANGADEX_API_URL=https://api.mangadex.org
MANGADEX_AUTH_URL=https://auth.mangadex.org/realms/mangadex/protocol/openid-connect/token
# Required by MangaDex API: format <AppName>/<Version> (<ContactURL_or_Email>)
MANGADEX_USER_AGENT=FlowdataMangaDex/1.0.0 (https://github.com/flowdata)

# --- Authentication Strategy 1: Pre-acquired Static JWT Token ---
# If set, StaticTokenAuth is automatically chosen.
# MANGADEX_ACCESS_TOKEN=eyJhbGciOi...
# MANGADEX_TOKEN=eyJhbGciOi...

# --- Authentication Strategy 2: Personal Client (OIDC Password Grant) ---
# Required if personal client credentials are used:
# MANGADEX_CLIENT_ID=personal-client-...
# MANGADEX_CLIENT_SECRET=...
# MANGADEX_USERNAME=my_mangadex_user
# MANGADEX_PASSWORD=my_secure_password

# --- Strategy 3: Anonymous Mode ---
# Leave all auth variables unset or commented to access public endpoints anonymously.
